    O31  => O(30),
    O32  => O(31),
    O33  => O(32),
    O34  => O(33),
    O35  => O(34),
    O36  => O(35),
    RA1  => RA(0),
    RA2  => RA(1),
    RA3  => RA(2),
    RA4  => RA(3),
    RA5  => RA(4),
    RA6  => '0',
    RA7  => '0',
    RA8  => '0',
    RA9  => '0',
    RA10 => '0',
    WA1 => WA(0),
    WA2 => WA(1),
    WA3 => WA(2),
    WA4 => WA(3),
    WA5 => WA(4),
    WA6 => '0',
    WE  => WE,
    WEA => WEA
);
