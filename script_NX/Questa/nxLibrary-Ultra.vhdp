-- =================================================================================================
--   NX_CDC_U mode configuration
-- =================================================================================================

library ieee;
use ieee.std_logic_1164.all;
use ieee.std_logic_unsigned.all;
use ieee.std_logic_arith.all;
use STD.textio.all;
use ieee.std_logic_textio.all;

package regfile_CDC_L_pkg is 
                                             
    -- DPREG Link Implementation                    
    constant Conf_2_REG_1RW_1RW_DPREG0_DPREG1        : std_logic_vector( 1 to 7 ):="0000000";
    constant Conf_2_REG_1R_1R_SPREG0_SPREG1          : std_logic_vector( 1 to 7 ):="1100000";
    constant Conf_1_REG_1RW_DEEPER                   : std_logic_vector( 1 to 7 ):="0011111";
    constant Conf_1_REG_1RW_WIDER                    : std_logic_vector( 1 to 7 ):="0001101";
    constant Conf_1_REG_2R_1W                        : std_logic_vector( 1 to 7 ):="0001100";

    function cfg_mode ( mode                         : integer; 
                        ck0_edge                     : std_logic;
                        ck1_edge                     : std_logic;
                        ack_sel                      : std_logic;
                        bck_sel                      : std_logic;
                        cck_sel                      : std_logic;
                        dck_sel                      : std_logic;
                        use_asrc_arst                : std_logic_vector(1 downto 0);
                        use_adest_arst               : std_logic_vector(1 downto 0);    
                        use_bsrc_arst                : std_logic_vector(1 downto 0);  
                        use_bdest_arst               : std_logic_vector(1 downto 0);   
                        use_csrc_arst                : std_logic_vector(1 downto 0);
                        use_cdest_arst               : std_logic_vector(1 downto 0);
                        use_dsrc_arst                : std_logic_vector(1 downto 0);
                        use_ddest_arst               : std_logic_vector(1 downto 0);
                        gt0_bypass_reg1              : std_logic;
                        gt0_bypass_reg2              : std_logic;
                        gt1_bypass_reg1              : std_logic;
                        gt1_bypass_reg2              : std_logic;
                        link_BA                      : std_logic;
                        link_CB                      : std_logic;
                        link_DC                      : std_logic
                        
        ) return std_logic_vector;


end package regfile_CDC_L_pkg;

package body regfile_CDC_L_pkg is 

    function cfg_mode ( mode                         : integer; 
                        ck0_edge                     : std_logic;
                        ck1_edge                     : std_logic;
                        ack_sel                      : std_logic;
                        bck_sel                      : std_logic;
                        cck_sel                      : std_logic;
                        dck_sel                      : std_logic;
                        use_asrc_arst                : std_logic_vector(1 downto 0);
                        use_adest_arst               : std_logic_vector(1 downto 0);    
                        use_bsrc_arst                : std_logic_vector(1 downto 0);  
                        use_bdest_arst               : std_logic_vector(1 downto 0);   
                        use_csrc_arst                : std_logic_vector(1 downto 0);
                        use_cdest_arst               : std_logic_vector(1 downto 0);
                        use_dsrc_arst                : std_logic_vector(1 downto 0);
                        use_ddest_arst               : std_logic_vector(1 downto 0);
                        gt0_bypass_reg1              : std_logic;
                        gt0_bypass_reg2              : std_logic;
                        gt1_bypass_reg1              : std_logic;
                        gt1_bypass_reg2              : std_logic;
                        link_BA                      : std_logic;
                        link_CB                      : std_logic;
                        link_DC                      : std_logic
                        
        ) return std_logic_vector is
        -- linked
        variable reg_cfg_linked                     : std_logic;
        --  cfg_reg0
        variable reg0_cdc_r2w_cfg_gray_linked       : std_logic;
        variable reg0_cdc_r2w_cfg_use_g2b           : std_logic;
        variable reg0_cdc_r2w_cfg_use_reg_src       : std_logic;
        variable reg0_cdc_r2w_cfg_clk_src_mux       : std_logic; -- manquant
        variable reg0_cdc_r2w_cfg_use_b2g           : std_logic;
        variable reg0_cdc_r2w_cfg_arst_src_sel      : std_logic_vector( 1 downto 0);
        variable reg0_cdc_r2w_cfg_arst_dest_sel     : std_logic_vector( 1 downto 0);
        variable reg0_cdc_r2w_cfg_cdc_clk           : std_logic;
        variable reg0_cfg_clkrd_inv                 : std_logic;
        variable reg0_cdc_cfg_dpreg_fifo            : std_logic;
        variable reg0_cfg_bypass_ram                : std_logic; -- manquant
        variable reg0_cfg_clkwr_inv                 : std_logic;
        variable reg0_cdc_w2r_cfg_use_g2b           : std_logic;
        variable reg0_cdc_w2r_cfg_gray_linked       : std_logic;
        variable reg0_cdc_w2r_cfg_arst_src_sel      : std_logic_vector( 1 downto 0);
        variable reg0_cdc_w2r_cfg_arst_dest_sel     : std_logic_vector( 1 downto 0);
        variable reg0_cdc_w2r_cfg_use_b2g           : std_logic;
        variable reg0_cfg_bypass_edac               : std_logic; -- manquant                               
        variable reg0_cdc_w2r_cfg_clk_src_mux       : std_logic; -- manquant    
        variable reg0_cdc_w2r_cfg_use_reg_src       : std_logic;
        variable reg0_cdc_w2r_cfg_cdc_clk           : std_logic;
        --  cfg_reg1
        variable reg1_cdc_r2w_cfg_use_reg_src       : std_logic;
        variable reg1_cdc_r2w_cfg_use_b2g           : std_logic;                            
        variable reg1_cdc_r2w_cfg_clk_src_mux       : std_logic; -- manquant
        variable reg1_cdc_r2w_cfg_cdc_clk           : std_logic;
        variable reg1_cdc_r2w_cfg_arst_src_sel      : std_logic_vector( 1 downto 0);
        variable reg1_cdc_r2w_cfg_arst_dest_sel     : std_logic_vector( 1 downto 0);
        variable reg1_cfg_clkrd_inv                 : std_logic;
        variable reg1_cdc_r2w_cfg_gray_linked       : std_logic; -- manquant
        variable reg1_cfg_bypass_edac               : std_logic; -- manquant
        variable reg1_cfg_clkwr_inv                 : std_logic;
        variable reg1_cdc_cfg_dpreg_fifo            : std_logic;
        variable reg1_cdc_w2r_cfg_cdc_clk           : std_logic;
        variable reg1_cfg_bypass_ram                : std_logic; -- manquant
        variable reg1_cdc_r2w_cfg_use_g2b           : std_logic;
        variable reg1_cdc_w2r_cfg_use_b2g           : std_logic;
        variable reg1_cdc_w2r_cfg_clk_src_mux       : std_logic; -- manquant
        variable reg1_cdc_w2r_cfg_use_reg_src       : std_logic;
        variable reg1_cdc_w2r_cfg_arst_src_sel      : std_logic_vector( 1 downto 0);
        variable reg1_cdc_w2r_cfg_use_g2b           : std_logic;                        
        variable reg1_cdc_w2r_cfg_gray_linked       : std_logic;
        variable reg1_cdc_w2r_cfg_arst_dest_sel     : std_logic_vector( 1 downto 0);

        variable gtc0_cfg_bypass_reg                : std_logic_vector( 1 downto 0);
        variable gtc1_cfg_bypass_reg                : std_logic_vector( 1 downto 0);
        variable gtc0_cfg_clk_in_inv                : std_logic;
        variable gtc1_cfg_clk_in_inv                : std_logic;


        variable DPREG_link_implementation          : std_logic_vector(1 to 7);
        
        variable regfile_config                     : std_logic_vector( 95 downto 0);


        begin
        -- mode :
            -- 0: 2DFF      
            -- 1: 3DFF     
            -- 2: bin2gray + 3DFF + gray2bin
            -- 3: bin2gray 
            -- 4: gray2bin 
            -- 5: XCDC

            ---------------------------------------------NG_LARGE-----------------------------------------------------------
            ----------------------------------------------------------------------------------------------------------------
            -- reg1
            reg1_cdc_r2w_cfg_use_reg_src                := '1' when mode = 1 or mode = 2 or mode = 5 else '0';
            reg1_cdc_r2w_cfg_use_b2g                    := '1' when mode = 2 or mode = 3 or mode = 5 else '0';
            reg1_cdc_r2w_cfg_clk_src_mux                := '0';
            reg1_cdc_r2w_cfg_arst_src_sel               := use_bsrc_arst  when mode = 1 or mode = 2 else use_dsrc_arst  when mode = 5 else "00";
            reg1_cdc_r2w_cfg_cdc_clk                    := bck_sel when mode = 0 or mode = 1 or mode = 2 else dck_sel when mode = 5 else '0';
            reg1_cdc_r2w_cfg_arst_dest_sel              := use_bdest_arst when mode = 0 or mode = 1 or mode = 2 else use_ddest_arst when mode = 5 else "00";
            reg1_cfg_clkrd_inv                          := '0';
            reg1_cdc_r2w_cfg_gray_linked                := '0';
            reg1_cfg_bypass_edac                        := '0';
            reg1_cfg_clkwr_inv                          := '0';
            reg1_cdc_cfg_dpreg_fifo                     := '0';
            reg1_cdc_w2r_cfg_cdc_clk                    := ack_sel when mode = 0 or mode = 1 or mode = 2 else bck_sel when mode = 5 else '0';
            reg1_cfg_bypass_ram                         := '0';
            reg1_cdc_r2w_cfg_use_g2b                    := '1' when mode = 2 or mode = 4 or mode = 5 else '0';
            gtc1_cfg_bypass_reg(1)                      := gt1_bypass_reg2;
            reg1_cdc_w2r_cfg_use_b2g                    := '1' when mode = 2 or mode = 3 or mode = 5 else '0';
            reg1_cdc_w2r_cfg_clk_src_mux                := '0';
            reg1_cdc_w2r_cfg_use_reg_src                := '1' when mode = 1 or mode = 2 or mode = 5 else '0';
            reg1_cdc_w2r_cfg_arst_src_sel               := use_asrc_arst when mode = 1 or mode = 2 else use_bsrc_arst when mode = 5 else "00";       
            reg1_cdc_w2r_cfg_use_g2b                    := '1' when mode = 2 or mode = 4 or mode = 5 else '0';
            reg1_cdc_w2r_cfg_gray_linked                := '0';
            reg1_cdc_w2r_cfg_arst_dest_sel              := use_adest_arst when mode = 0 or mode = 1 or mode = 2 else use_bdest_arst when mode = 5  else "00";
            gtc1_cfg_clk_in_inv                         := '0';
            gtc1_cfg_bypass_reg(0)                      := gt1_bypass_reg1;
            reg_cfg_linked                              := '0';
            gtc0_cfg_clk_in_inv                         := '0';
            gtc0_cfg_bypass_reg(1)                      := gt0_bypass_reg2;
            reg0_cdc_r2w_cfg_gray_linked                := link_DC when mode = 5 else '0';
            reg0_cdc_r2w_cfg_use_g2b                    := '1' when mode = 2 or mode = 4 or mode = 5 else '0';
            reg0_cdc_r2w_cfg_use_reg_src                := '1' when mode = 1 or mode = 2 or mode = 5 else '0';
            reg0_cdc_r2w_cfg_clk_src_mux                := '0';
            reg0_cdc_r2w_cfg_use_b2g                    := '1' when mode = 2 or mode = 3 or mode = 5 else '0';
            reg0_cdc_r2w_cfg_arst_src_sel               := use_bsrc_arst  when mode = 1 or mode = 2 else use_csrc_arst when mode = 5 else "00";
            reg0_cdc_r2w_cfg_arst_dest_sel              := use_bdest_arst when mode = 0 or mode = 1 or mode = 2 else use_cdest_arst when mode = 5 else "00";
            reg0_cdc_r2w_cfg_cdc_clk                    := bck_sel when mode = 0 or mode = 1 or mode = 2 else cck_sel when mode = 5 else '0';
            reg0_cfg_clkrd_inv                          := '0';
            reg0_cdc_cfg_dpreg_fifo                     := '0';
            gtc0_cfg_bypass_reg(0)                      := gt0_bypass_reg1;
            reg0_cfg_bypass_ram                         := '0';
            reg0_cfg_clkwr_inv                          := '0';
            reg0_cdc_w2r_cfg_use_g2b                    := '1' when mode = 2 or mode = 4 or mode = 5 else '0';
            reg0_cdc_w2r_cfg_gray_linked                :=  link_BA when mode = 5 else '0';
            reg0_cdc_w2r_cfg_arst_src_sel               := use_asrc_arst  when mode = 1 or mode = 2 or mode = 5 else "00";
            reg0_cdc_w2r_cfg_arst_dest_sel              := use_adest_arst when mode = 0 or mode = 1 or mode = 2 or mode = 5 else "00";
            reg0_cdc_w2r_cfg_use_b2g                    := '1' when mode = 2 or mode = 3 or mode = 5 else '0';
            reg0_cfg_bypass_edac                        := '0';
            reg0_cdc_w2r_cfg_clk_src_mux                := '0';
            reg0_cdc_w2r_cfg_use_reg_src                := '1' when mode = 1 or mode = 2 or mode = 5 else '0';
            reg0_cdc_w2r_cfg_cdc_clk                    := ack_sel when mode = 0 or mode = 1 or mode = 2 or mode = 5 else '0';
            ---------------------------------------------------------------------------------
 
            regfile_config(95 downto 94)     := "00"            ;  
            regfile_config(93)               := reg1_cdc_r2w_cfg_use_reg_src            ;  
            regfile_config(92)               := reg1_cdc_r2w_cfg_use_b2g            ;  
            regfile_config(91)               := '0'            ;  
            regfile_config(90)               := reg1_cdc_r2w_cfg_clk_src_mux            ;  
            regfile_config(89)               := reg1_cdc_r2w_cfg_arst_src_sel (1)            ;  
            regfile_config(88)               := reg1_cdc_r2w_cfg_arst_src_sel (0)            ;  
            regfile_config(87)               := reg1_cdc_r2w_cfg_cdc_clk            ;  
            regfile_config(86)               := '0'            ;  
            regfile_config(85)               := '0'            ;  
            regfile_config(84)               := '0'            ;  
            regfile_config(83)               := reg1_cdc_r2w_cfg_arst_dest_sel (1)           ;  
            regfile_config(82)               := reg1_cdc_r2w_cfg_arst_dest_sel (0)            ;  
            regfile_config(81)               := reg1_cfg_clkrd_inv            ;  
            regfile_config(80)               := reg1_cdc_r2w_cfg_gray_linked             ;  
            regfile_config(79)               := reg1_cfg_bypass_edac            ;  
            regfile_config(78)               := reg1_cfg_clkwr_inv            ;  
            regfile_config(77)               := reg1_cdc_cfg_dpreg_fifo            ;  
            regfile_config(76 downto 71)     := "000000"            ;  
            regfile_config(70)               := reg1_cdc_w2r_cfg_cdc_clk            ;  
            regfile_config(69)               := reg1_cfg_bypass_ram            ;  
            regfile_config(68)               := reg1_cdc_r2w_cfg_use_g2b            ;  
            regfile_config(67 downto 66)     := "00"            ;  
            regfile_config(65)               := gtc1_cfg_bypass_reg(1)            ;  
            regfile_config(64)               := reg1_cdc_w2r_cfg_use_b2g             ;  
            regfile_config(63)               := reg1_cdc_w2r_cfg_clk_src_mux            ;  
            regfile_config(62)               := reg1_cdc_w2r_cfg_use_reg_src            ;  
            regfile_config(61)               := reg1_cdc_w2r_cfg_arst_src_sel(1)           ;  
            regfile_config(60)               := reg1_cdc_w2r_cfg_arst_src_sel(0)             ;  
            regfile_config(59 downto 57)     := "000"            ;  
            regfile_config(56)               := reg1_cdc_w2r_cfg_use_g2b            ;  
            regfile_config(55)               := '0'            ;  
            regfile_config(54)               := reg1_cdc_w2r_cfg_gray_linked            ;  
            regfile_config(53)               := reg1_cdc_w2r_cfg_arst_dest_sel(1)            ;  
            regfile_config(52)               := reg1_cdc_w2r_cfg_arst_dest_sel(0)            ;  
            regfile_config(51)               := '0'             ;  
            regfile_config(50)               := gtc1_cfg_clk_in_inv            ;  
            regfile_config(49)               := gtc1_cfg_bypass_reg(0)            ;  
            regfile_config(48)               := reg_cfg_linked            ;  
            regfile_config(47)               := gtc0_cfg_clk_in_inv            ;  
            regfile_config(46)               := gtc0_cfg_bypass_reg(1)             ;  
            regfile_config(45)               := reg0_cdc_r2w_cfg_gray_linked            ;  
            regfile_config(44)               := reg0_cdc_r2w_cfg_use_g2b            ;  
            regfile_config(43 downto 40)     := "0000"            ;  
            regfile_config(39)               := reg0_cdc_r2w_cfg_use_reg_src            ;  
            regfile_config(38)               := reg0_cdc_r2w_cfg_clk_src_mux            ;  
            regfile_config(37)               := reg0_cdc_r2w_cfg_use_b2g            ;  
            regfile_config(36)               := reg0_cdc_r2w_cfg_arst_src_sel(1)            ;  
            regfile_config(35)               := reg0_cdc_r2w_cfg_arst_src_sel(0)            ;  
            regfile_config(34 downto 33)     := reg0_cdc_r2w_cfg_arst_dest_sel            ;  
            regfile_config(32)               := reg0_cdc_r2w_cfg_cdc_clk            ;  
            regfile_config(31 downto 28)     := "0000"            ;  
            regfile_config(27)               := reg0_cfg_clkrd_inv            ;  
            regfile_config(26)               := reg0_cdc_cfg_dpreg_fifo            ;  
            regfile_config(25)               := gtc0_cfg_bypass_reg(0)            ;  
            regfile_config(24)               := reg0_cfg_bypass_ram            ;  
            regfile_config(23)               := reg0_cfg_clkwr_inv            ;  
            regfile_config(22)               := reg0_cdc_w2r_cfg_use_g2b            ;  
            regfile_config(21)               := reg0_cdc_w2r_cfg_gray_linked            ;  
            regfile_config(20)               := '0'            ;  
            regfile_config(19 downto 18)     := reg0_cdc_w2r_cfg_arst_dest_sel            ;  
            regfile_config(17)               := reg0_cdc_w2r_cfg_use_b2g            ;  
            regfile_config(16)               := reg0_cdc_w2r_cfg_arst_src_sel (1)            ;  
            regfile_config(15)               := reg0_cdc_w2r_cfg_arst_src_sel (0)            ;  
            regfile_config(14)               := reg0_cfg_bypass_edac            ;  
            regfile_config(13)               := '0'            ;  
            regfile_config(12)               := '0'            ;  
            regfile_config(11)               := reg0_cdc_w2r_cfg_clk_src_mux            ;  
            regfile_config(10)               := '0'            ;  
            regfile_config( 9)               := reg0_cdc_w2r_cfg_use_reg_src            ;   
            regfile_config( 8)               := reg0_cdc_w2r_cfg_cdc_clk            ;   
            regfile_config( 7)               := '0'            ;   
            regfile_config( 6)               := '0'             ;   
            regfile_config( 5 downto 0)      := "000000"             ;
            
            return regfile_config(95 downto 0);
        
    end cfg_mode;    
    
end package body regfile_CDC_L_pkg;
