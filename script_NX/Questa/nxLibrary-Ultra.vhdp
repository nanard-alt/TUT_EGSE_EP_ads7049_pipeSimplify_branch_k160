library NX;
use NX.nxPackage.all;

architecture NX_RTL of NX_HSSL_L_FULL is

signal LINK_RX0 : std_logic_vector(CRX_LINK_SIZE-1 downto 0);
signal LINK_RX1 : std_logic_vector(CRX_LINK_SIZE-1 downto 0);
